#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define FN   1

/ {
    behaviors {
        /* Single tap is intentionally disabled; double tap sends QSAVE. */
        td_qsave: tap_dance_qsave {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&none>, <&kp F11>;
        };

        /* Single tap is intentionally disabled; double tap sends QLOAD. */
        td_qload: tap_dance_qload {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&none>, <&kp F12>;
        };

        /* Single tap is intentionally disabled; double tap sends Win+D. */
        td_desktop: tap_dance_desktop {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&none>, <&kp LG(D)>;
        };

        /*
         * Initial safe SYS behavior:
         * - single tap: next BLE profile
         * - double tap: toggle USB/BLE output
         * Long-press status and pairing clear are deferred until LED feedback
         * and destructive-action confirmation are implemented together.
         */
        td_sys: tap_dance_sys {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&bt BT_NXT>, <&out OUT_TOG>;
        };

        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            /* Hardware reports clockwise as the negative direction.
             * First binding is CCW, second binding is CW. */
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
            /* &msc is hold-style; 20 ms guarantees one wheel report per
             * encoder detent instead of releasing before the first tick. */
            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "GALGAME";

            /* FAST AUTO NEXT QSAVE DESKTOP SYS FN QLOAD ENC_SW */
            bindings = <
                &kp LCTRL
                &kp A
                &kp ENTER
                &td_qsave
                &td_desktop
                &td_sys
                &tog FN
                &td_qload
                &kp ESC
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        fn_layer {
            display-name = "FN";

            /* FAST AUTO NEXT QSAVE DESKTOP SYS FN QLOAD ENC_SW */
            bindings = <
                &kp S
                &kp R
                &kp L
                &td_qsave
                &td_desktop
                &td_sys
                &tog FN
                &td_qload
                &kp C_MUTE
            >;

            /* Clockwise = volume up, counter-clockwise = volume down. */
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };
    };
};
