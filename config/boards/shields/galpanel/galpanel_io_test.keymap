/* GALPANEL nine-input test: each physical input emits one digit. */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        io_test_layer {
            display-name = "IO TEST";
            bindings = <
                &kp N1 &kp N2 &kp N3
                &kp N4 &kp N5 &kp N6
                &kp N7 &kp N8 &kp N9
            >;
        };
    };
};
