#include <behaviors.dtsi>

/ {
    keymap {
        compatible = "zmk,keymap";

        led_test_layer {
            display-name = "LED TEST";
            bindings = <
                &none &none &none
                &none &none &none
                &none &none &none
            >;
        };
    };
};
