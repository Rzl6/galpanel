/* GALPANEL nine-key + EC11 test: keys emit digits; rotation emits mouse scroll. */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        ec11_test_layer {
            display-name = "EC11 TEST";

            /* D2 FAST, D3 AUTO, D4 NEXT, D5 QSAVE, D7 DESKTOP,
             * D8 SYS, D14 FN, D18 QLOAD, D19 EC11_SW. */
            bindings = <
                &kp N1 &kp N2 &kp N3
                &kp N4 &kp N5 &kp N6
                &kp N7 &kp N8 &kp N9
            >;

            /* Hardware reports clockwise as negative: CCW=scroll up, CW=scroll down. */
            sensor-bindings = <&inc_dec_kp SCRL_UP SCRL_DOWN>;
        };
    };
};
