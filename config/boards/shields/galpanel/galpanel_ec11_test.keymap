/* GALPANEL nine-key + EC11 test: keys emit digits; rotation emits mouse scroll. */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        encoder_scroll_test: encoder_scroll_test {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            /* First binding is CCW, second is CW on this hardware. */
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
            /* &msc is a hold-style behavior. Keep it long enough for one
             * input-two-axis tick to produce a non-zero wheel report. */
            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        ec11_test_layer {
            display-name = "EC11 TEST";

            /* D2 FAST, D3 AUTO, D4 NEXT, D5 QSAVE (right upper),
             * D7 DESKTOP (right lower), D8 SYS, D14 FN (left lower),
             * D18 QLOAD (left upper), D19 EC11_SW. */
            bindings = <
                &kp N1 &kp N2 &kp N3
                &kp N4 &kp N5 &kp N6
                &kp N7 &kp N8 &kp N9
            >;

            /* Hardware reports clockwise as negative: CCW=scroll up, CW=scroll down. */
            sensor-bindings = <&encoder_scroll_test>;
        };
    };
};
